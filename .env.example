# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# One AI provider
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Public URL of the deployment (used for PayPal return URLs and the MCP address)
PUBLIC_URL=

# Optional: shown on the home page so testers can approve sandbox holds
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Optional: AG Studio licence key (removes the trial watermark)
NEXT_PUBLIC_AG_LICENSE_KEY=
